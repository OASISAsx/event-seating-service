# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_MAX_MESSAGES=1000

# Frontend origins allowed to call the API and Socket.IO.
# Comma-separated when you need to add more than one origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://event-seat.elitefund.fun

# For Docker environment, use:
# RABBITMQ_URL=amqp://rabbitmq:5672
# REDIS_URL=redis://redis:6379
